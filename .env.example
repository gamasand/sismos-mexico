# Copia este archivo a .env antes del primer arranque.
# Sustituye ambos marcadores por contraseñas propias y distintas.
# No publiques .env ni las credenciales reales.
MYSQL_ROOT_PASSWORD=CAMBIA_ESTA_CLAVE_ROOT
MYSQL_PASSWORD=CAMBIA_ESTA_CLAVE_USUARIO

# Radio en km para las tres consultas históricas alrededor del epicentro USGS.
# Valor admitido: mayor que 0 y hasta 2000. Cambiarlo invalida su caché.
HISTORICAL_RADIUS_KM=250
